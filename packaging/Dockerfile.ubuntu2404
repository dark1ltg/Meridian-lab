# Build a Meridian AppImage linked against Ubuntu 24.04's glibc (2.39).
# Usage (from repo root, with Docker/Podman):
#   docker build -f packaging/Dockerfile.ubuntu2404 -t meridian-u2404-build .
#   docker run --rm -v "$PWD:/src" -w /src meridian-u2404-build
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    libaubio-dev \
    build-essential \
    pkg-config \
    curl \
    ca-certificates \
    squashfs-tools \
    libgl1 \
    libegl1 \
    libglib2.0-0 \
    libxkbcommon0 \
    libdbus-1-3 \
    libxcb-cursor0 \
    libxcb-xinerama0 \
    libx11-xcb1 \
    libxi6 \
    libxrender1 \
    libxext6 \
    libsm6 \
    libice6 \
    libfontconfig1 \
    libfreetype6 \
    file \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
CMD ["bash", "packaging/build-appimage-ubuntu2404.sh", "--inside-container"]
